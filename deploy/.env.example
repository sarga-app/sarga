# Rename this file to .env and edit. docker compose reads .env automatically.

# Container timezone (e.g. America/New_York, Europe/London). Affects log timestamps.
# TZ=Etc/UTC

# Full list of supported env variables: https://docs.sarga.app/install/environment-variables

# The SQLite database lives at <data.dir>/sarga.db (default /data/sarga.db in the container).
# No separate database service needed.
